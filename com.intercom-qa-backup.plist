<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.intercom-qa-backup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/rustem/Desktop/intercomSummary/scripts/backup.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/rustem/Desktop/intercomSummary</string>

  <!-- Run daily at 03:00 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/rustem/Library/Logs/intercom-qa-backup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/rustem/Library/Logs/intercom-qa-backup.err</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
