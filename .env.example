# ── Intercom ────────────────────────────────────────────────────────────────
# Create at: Intercom → Settings → Integrations → Developer Hub → your app →
#            Authentication → Access token
INTERCOM_ACCESS_TOKEN=
# Region your Intercom workspace stores data in: us | eu | au
#   us → https://api.intercom.io   eu → https://api.eu.intercom.io   au → https://api.au.intercom.io
INTERCOM_REGION=eu
# Pinned Intercom API version (https://developers.intercom.com/docs/build-an-integration/learn-more/rest-apis/api-versioning/)
INTERCOM_API_VERSION=2.11

# ── QA grading backend ────────────────────────────────────────────────────────
# Which engine grades conversations:
#   ollama → local Ollama server running Qwen (default; free, no API key; uses casino QA prompt)
#   api    → Anthropic API (needs ANTHROPIC_API_KEY below)
QA_BACKEND=ollama
# For QA_BACKEND=ollama (Qwen):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
# Keep the model resident between grades (overrides the server's OLLAMA_KEEP_ALIVE, which
# may be 0 = reload every grade). Leave NUM_CTX/NUM_PREDICT at 0 to use Ollama's defaults;
# raise NUM_CTX only if long transcripts are being truncated (slower prefill).
QA_OLLAMA_KEEP_ALIVE=30m
QA_OLLAMA_NUM_CTX=0
QA_OLLAMA_NUM_PREDICT=0
# For QA_BACKEND=api:
ANTHROPIC_API_KEY=
QA_MODEL=claude-opus-4-8

# ── Slack bot (Socket Mode) ───────────────────────────────────────────────────
# Bot User OAuth Token (starts xoxb-)
SLACK_BOT_TOKEN=xoxb-...
# App-Level Token with connections:write scope (starts xapp-) — required for Socket Mode
SLACK_APP_TOKEN=xapp-...
# Signing secret (not strictly needed for Socket Mode but kept for completeness)
SLACK_SIGNING_SECRET=

# ── Web dashboard ─────────────────────────────────────────────────────────────
# Secret used to sign session cookies — set to a long random string in production.
WEB_SECRET_KEY=change-me-to-a-long-random-string
WEB_HOST=127.0.0.1
WEB_PORT=8000
# Public base URL of the dashboard (used by Slack "Open dashboard" buttons).
WEB_BASE_URL=http://127.0.0.1:8000

# ── Local paths ───────────────────────────────────────────────────────────────
DB_PATH=./data/grades.db
ROLES_PATH=./config/roles.yaml
RULES_PATH=./rules/support_rules.md
EXPORT_DIR=./data/exports
WEB_USERS_PATH=./config/web_users.yaml
EVAL_DIR=./data/eval
